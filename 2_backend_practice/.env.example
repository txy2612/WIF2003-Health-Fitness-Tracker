NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

MONGODB_URI=

# DNS fallback servers used if MongoDB SRV lookup has issues
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# SMTP settings for reminder emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="FitTrack <no-reply@fittrack.local>"

# Cron settings for due reminder emails
REMINDER_CRON_SCHEDULE="*/1 * * * *" # run ev min
REMINDER_BATCH_SIZE=10
REMINDER_SEND_LOCK_MINUTES=10
REMINDER_TIMEZONE=Asia/Kuala_Lumpur
